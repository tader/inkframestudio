            "id": "node-b9699522",
            "outputMode": "merge_object",
            "source": "const OFFSET_SECONDS = 60;\n\nconst minutes_map = [\n  \"\",             // 0 → exact hour\n  \"vijf over\",    // 5\n  \"tien over\",    // 10\n  \"kwart over\",   // 15\n  \"tien voor\",    // 20\n  \"vijf voor\",    // 25\n  \"\",             // 30 → handled as \"half\"\n  \"vijf over\",    // 35\n  \"tien over\",    // 40\n  \"kwart voor\",   // 45\n  \"tien voor\",    // 50\n  \"vijf voor\",    // 55\n];\n\nconst hours_text = [\n  \"twaalf\",\n  \"één\",\n  \"twee\",\n  \"drie\",\n  \"vier\",\n  \"vijf\",\n  \"zes\",\n  \"zeven\",\n  \"acht\",\n  \"negen\",\n  \"tien\",\n  \"elf\",\n];\n\nconst now = new Date(Date.now() + OFFSET_SECONDS * 1000);\nconst hours = now.getHours();\nconst minutes = now.getMinutes();\nconst seconds = now.getSeconds();\n\n// nearest 5-minute bucket\nconst index = Math.round((minutes + seconds / 60) / 5) % 12;\n\n// determine hour base\nconst isHalfOrAfter = index >= 4; // from 20 min onward → next hour\nconst hourIndex = (hours + (isHalfOrAfter ? 1 : 0)) % 12;\n\n// build hours_line\nlet hours_line;\nif (index === 6) {\n  // exactly half\n  hours_line = `half ${hours_text[hourIndex]}`;\n} else if (index > 3 && index < 9) {\n  // around half (20–40)\n  hours_line = `half ${hours_text[hourIndex]}`;\n} else {\n  // normal hour reference\n  hours_line = hours_text[hourIndex];\n}\n\n// minutes_line\nlet minutes_line = minutes_map[index];\n\n// special case: exact hour\nif (index === 0) {\n  hours_line = `${hours_text[hours % 12]} uur`;\n  minutes_line = \"\";\n}\n\nreturn {\n  minutes_line,\n  hours_line,\n};\n",
